[user]
	email = e@giovani.dev
    name = mgiovani
[core]
    editor = vim
	pager = delta
	autocrlf = input
[diff]
    tool = vimdiff
    colorMoved = no
[alias]
    slog = log --all --graph --pretty=format:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
[color]
    ui = true
[include]
    path = ~/projects/dotfiles/git/delta-themes.gitconfig

[delta]
    navigate = true
    side-by-side = false
    features = mellow-barbet

[blame]
    pager = delta

[merge]
    tool = vimdiff
    conflictstyle = zdiff3
[interactive]
    diffFilter = delta --color-only
[gpg]
    program = gpg
[commit]
    gpgsign = false
[mergetool "vimdiff"]
    cmd = vim -d "$LOCAL" "$MERGED" "$REMOTE"
[push]
    default = simple
[grep]
    break = true
    heading = true
    lineNumber = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[init]
	defaultBranch = main
